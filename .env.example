# ── Required ────────────────────────────────────────────────
# Claude API key (server only). Not needed when MOCK_LLM=1.
ANTHROPIC_API_KEY=
# Shared demo password for the gate. Pick your own; never commit it.
SITE_PASSWORD=

# ── Optional ────────────────────────────────────────────────
# Advanced: separate key for signing the session cookie (e.g. `openssl rand -hex 32`).
# If unset, a key is derived from SITE_PASSWORD (so changing the password logs everyone out).
# Set it if you want to rotate sessions independently of the password.
AUTH_SECRET=
# 1 = canned answers/translations, no Claude calls (local testing, previews).
MOCK_LLM=0

# ── Crawl script only (`npm run crawl`) ─────────────────────
APIFY_TOKEN=
# CRAWL_MAX_PAGES=150
# CRAWL_PRIORITY_MAX=2
# CRAWL_MAX_DEPTH=3
# CRAWL_MAX_PDFS=40

# ── Spending guard (optional) ───────────────────────────────
# 1 = no AI calls at all (free search, guides and cached answers keep working).
# AI_DISABLED=0
# Daily AI budget in US$ across all servers (default 5), and daily quotas per visitor.
# AI_DAILY_BUDGET_USD=5
# AI_DAILY_PER_IP=40
# TRANSLATE_DAILY_PER_IP=10

# ── Shared store (optional, Upstash Redis via the Vercel integration) ──
# Shares the budget, quotas and answer cache between servers. Without it each server keeps its own.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Feedback and contact (optional) ─────────────────────────
# FEEDBACK_WEBHOOK_URL=
# CONTACT_EMAIL=
